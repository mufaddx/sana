# Copy to .env and fill in real values. Never commit the filled-in .env.
# On a hosting platform, set these in its environment variables section instead.

# --- Database -----------------------------------------------------------
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_DATABASE=
MYSQL_USER=
MYSQL_PASSWORD=

# --- Email (admin OTP login + Linking Box delivery notifications) -------
# Without these the admin workspace cannot be entered: there is no password
# fallback, login is passcode-by-email only.
SMTP_HOST=
SMTP_PORT=465
SMTP_ENCRYPTION=ssl
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=Real World Link
# Where new submissions are announced
MAIL_ADMIN_ADDRESS=

# --- Admin workspace ----------------------------------------------------
# Only these addresses can request a login passcode. Comma separated, no spaces.
ADMIN_EMAILS=
# Long random string used to sign admin session cookies. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=

# --- Site ---------------------------------------------------------------
NODE_ENV=production
# Public origin, no trailing slash. Used to build student tracking links.
PUBLIC_BASE_URL=

# PORT is supplied by the host at runtime.
